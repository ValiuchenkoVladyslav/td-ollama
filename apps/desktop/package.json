{
  "name": "td-ollama-desktop",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tauri dev -c core/tauri.conf.json",
    "next-build": "next build --no-lint",
    "build": "tauri build -c core/tauri.conf.json",
    "build:debug": "tauri build -c core/tauri.conf.json -d",
    "lint": "cd ./core && cargo clippy --no-deps && cargo fmt --check",
    "lint:fix": "cd ./core && cargo clippy --no-deps --fix --allow-dirty --allow-staged && cargo fmt"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.12",
    "@radix-ui/react-select": "^2.2.2",
    "@radix-ui/react-separator": "^1.1.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.2.2",
    "@tauri-apps/api": "2.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.503.0",
    "next": "15.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.1",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.2.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.5",
    "@tauri-apps/cli": "^2.5.0",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "tailwindcss": "^4.1.5",
    "typescript": "^5.8.3"
  }
}
